 "fields": [
  {
   "fieldname": "traccar_section",
   "fieldtype": "Section Break",
   "label": "Traccar Server"
  },
  {
   "fieldname": "traccar_url",
   "fieldtype": "Data",
   "label": "Traccar Server URL",
   "default": "https://gps.hipersignerp.cloud",
   "description": "The address you open Traccar on, e.g. https://gps.hipersignerp.cloud"
  },
  {
   "fieldname": "auth_method",
   "fieldtype": "Select",
   "label": "Sign-in Method",
   "options": "API Token\nEmail and Password",
   "default": "API Token"
  },
  {
   "fieldname": "api_token",
   "fieldtype": "Password",
   "label": "Traccar API Token",
   "depends_on": "eval:doc.auth_method=='API Token'",
   "description": "In Traccar: Settings → Account (your user) → Token → generate and copy here. Use an admin user so every device is visible."
  },
  {
   "fieldname": "traccar_email",
   "fieldtype": "Data",
   "label": "Traccar Email",
   "depends_on": "eval:doc.auth_method=='Email and Password'"
  },
  {
   "fieldname": "traccar_password",
   "fieldtype": "Password",
   "label": "Traccar Password",
   "depends_on": "eval:doc.auth_method=='Email and Password'"
  },
  {
   "fieldname": "duty_section",
   "fieldtype": "Section Break",
   "label": "Check In / Check Out & GPS Alarm"
  },
  {
   "fieldname": "duty_mode",
   "fieldtype": "Check",
   "label": "Track Only Between Check In and Check Out",
   "default": "1",
   "description": "Phones start tracking (and the GPS-off alarm) when the worker checks in from the app, and stop when they check out. Check-ins are saved as Employee Checkin with the location."
  },
  {
   "fieldname": "require_location_checkin",
   "fieldtype": "Check",
   "label": "Require Location to Check In / Out",
   "default": "1"
  },
  {
   "fieldname": "duty_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "alarm_interval",
   "fieldtype": "Int",
   "label": "GPS-off Alarm Repeat (seconds)",
   "default": "30",
   "description": "While a checked-in worker's GPS is off, the phone rings again every this many seconds (minimum 10)."
  },
  {
   "fieldname": "escalate_after",
   "fieldtype": "Int",
   "label": "Notify Head After (repeat alarms)",
   "default": "1",
   "description": "1 = notify the head on the 2nd alarm (after one repeat). 0 = notify straight away."
  },
  {
   "fieldname": "phone_section",
   "fieldtype": "Section Break",
   "label": "Phone App"
  },
  {
   "fieldname": "phone_report_url",
   "fieldtype": "Data",
   "label": "Phone Report URL",
   "default": "http://gps.hipersignerp.cloud:5055",
   "description": "Where the HiperTracker phone app sends locations (Traccar's device port, usually 5055). Put into the phone by the setup QR on each device."
  },
  {
   "fieldname": "app_download_url",
   "fieldtype": "Data",
   "label": "App Download Link",
   "default": "https://github.com/hipersignerp-dev/Hipersign-traccar-client/releases/latest/download/HiperTracker.apk",
   "description": "Shown as the 'Install app' QR on each device."
  },
  {
   "fieldname": "phone_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "phone_interval",
   "fieldtype": "Int",
   "label": "Phone Report Interval (seconds)",
   "default": "60"
  },
  {
   "fieldname": "phone_distance",
   "fieldtype": "Int",
   "label": "Phone Report Distance (metres)",
   "default": "50"
  },
  {
   "fieldname": "auto_create_in_traccar",
   "fieldtype": "Check",
   "label": "Create Devices in Traccar Automatically",
   "default": "1",
   "description": "Saving a device here adds it to Traccar (or renames it) with the same identifier."
  },
  {
   "fieldname": "map_section",
   "fieldtype": "Section Break",
   "label": "Map"
  },
  {
   "fieldname": "map_center_lat",
   "fieldtype": "Float",
   "label": "Map Centre Latitude",
   "default": "10.55",
   "precision": "6"
  },
  {
   "fieldname": "map_center_lon",
   "fieldtype": "Float",
   "label": "Map Centre Longitude",
   "default": "76.3",
   "precision": "6"
  },
  {
   "fieldname": "map_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "map_zoom",
   "fieldtype": "Int",
   "label": "Map Zoom",
   "default": "8",
   "description": "8 shows all of Kerala"
  },
  {
   "fieldname": "refresh_seconds",
   "fieldtype": "Int",
   "label": "Auto-refresh (seconds)",
   "default": "30"
  },
  {
   "fieldname": "rules_section",
   "fieldtype": "Section Break",
   "label": "Rules"
  },
  {
   "fieldname": "stale_minutes",
   "fieldtype": "Int",
   "label": "Mark Offline After (minutes)",
   "default": "15",
   "description": "A phone with no update for this long is shown as offline, even if Traccar still says online."
  },
  {
   "fieldname": "show_unassigned",
   "fieldtype": "Check",
   "label": "Show Unassigned Traccar Devices on Map",
   "default": "1",
   "description": "System Managers also see Traccar devices not yet linked to a person."
  }
 ],
