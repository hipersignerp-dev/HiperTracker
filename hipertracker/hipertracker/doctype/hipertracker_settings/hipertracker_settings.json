   "fieldname": "traccar_section",
   "fieldtype": "Section Break",
   "label": "Traccar Server"
  },
  {
   "fieldname": "traccar_url",
   "fieldtype": "Data",
   "label": "Traccar Server URL",
   "default": "https://gps.hipersignerp.cloud",
   "description": "The address you open Traccar on, e.g. https://gps.hipersignerp.cloud"
  },
  {
   "fieldname": "auth_method",
   "fieldtype": "Select",
   "label": "Sign-in Method",
   "options": "API Token\nEmail and Password",
   "default": "API Token"
  },
  {
   "fieldname": "api_token",
   "fieldtype": "Password",
   "label": "Traccar API Token",
   "depends_on": "eval:doc.auth_method=='API Token'",
   "description": "In Traccar: Settings → Account (your user) → Token → generate and copy here. Use an admin user so every device is visible."
  },
  {
   "fieldname": "traccar_email",
   "fieldtype": "Data",
   "label": "Traccar Email",
   "depends_on": "eval:doc.auth_method=='Email and Password'"
  },
  {
   "fieldname": "traccar_password",
   "fieldtype": "Password",
   "label": "Traccar Password",
   "depends_on": "eval:doc.auth_method=='Email and Password'"
  },
